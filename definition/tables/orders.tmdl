table orders
	lineageTag: 894e13f2-e690-4a2b-80a2-bd8ad900d1e6

	measure 'Total Sales (M)' = ```
			DIVIDE([Total Sales], 1000000)
			
			```
		lineageTag: 03a37a8b-8f88-4573-9835-3403c03417c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Orders' = ```
			COUNTROWS(orders)
			
			```
		formatString: 0
		lineageTag: 2fccec7c-24db-4caa-91ff-85211fe1e4a2

	measure 'Total Orders (K)' = ```
			FORMAT([Total Orders]/1000, "0.00") & "K"
			
			```
		lineageTag: cbc7fdd3-438b-401a-be85-32b72f328a2f

	measure 'Total Customers' = ```
			DISTINCTCOUNT(customers[customer_id])
			
			```
		formatString: 0
		lineageTag: aacfd4a8-a6df-4476-80c2-c6e59ae4c0cb

	measure 'Active Brands' = ```
			CALCULATE(COUNTROWS(brands), brands[is_active] = TRUE)
			
			```
		formatString: 0
		lineageTag: ec78d65b-1c4a-47dd-8048-6f5c66502511

